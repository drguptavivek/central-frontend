FROM node:22.21.1-slim

# Install Nginx and git (git is often needed for dependencies)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    git \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

# Copy entrypoint script (do this early so it's cached)
COPY start-dev.sh /usr/src/app/
RUN chmod +x /usr/src/app/start-dev.sh

# Copy package files (for reference, but install happens at runtime)
COPY package.json package-lock.json ./

# Copy the rest of the application code
COPY . .

# Note: npm install runs at container startup via start-dev.sh
# Dependencies are persisted in the client-node-modules named volume

# Expose Vite port
EXPOSE 8989

# Start the dev server with dependency installation
CMD ["/bin/bash", "/usr/src/app/start-dev.sh"]
